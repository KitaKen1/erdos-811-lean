  have h1 := q8Perm_move_right (e0 ++ e1)
    (e2 ++ [a2] ++ e3 ++ [a3] ++ e4 ++ [a4] ++ e5 ++ [a5] ++
      e6 ++ [a6] ++ [a0]) a1
  have h2 := q8Perm_move_right (e0 ++ e1 ++ e2)
    (e3 ++ [a3] ++ e4 ++ [a4] ++ e5 ++ [a5] ++ e6 ++ [a6] ++
