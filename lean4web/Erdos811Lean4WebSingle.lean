lemma q8InfinityRawB_mod4 (x : Fin 7 → Nat) :
    (q8Pairs.map (q8InfinityRawB x)).sum % 4 =
      (4 - ((x 0 % 2 + x 1 % 2 + x 2 % 2 + x 3 % 2 +
        x 4 % 2 + x 5 % 2 + x 6 % 2) +
        Nat.choose (x 0 % 2 + x 1 % 2 + x 2 % 2 + x 3 % 2 +
