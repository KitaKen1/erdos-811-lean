namespace Erdos811Q9UnanchoredScalar

theorem finite_parity_candidates (r : Nat) (hr : r ≤ 9)
    (h : (r * (r - 1) / 2) % 4 = 2) : r = 4 ∨ r = 5 := by
  have checked : ∀ r : Fin 10,
      (r.val * (r.val - 1) / 2) % 4 = 2 → r.val = 4 ∨ r.val = 5 := by
    decide
  exact checked ⟨r, by omega⟩ h

theorem infinity_parity_candidates (r : Nat) (hr : r ≤ 8)
    (h : (r * (r + 1) / 2) % 9 = 0) : r = 0 ∨ r = 8 := by
  have checked : ∀ r : Fin 9,
      (r.val * (r.val + 1) / 2) % 9 = 0 → r.val = 0 ∨ r.val = 8 := by
    decide
  exact checked ⟨r, by omega⟩ h

theorem binary_cut_bound (a : Nat) (ha : a ≤ 8) : a * (8 - a) ≤ 16 := by
  have checked : ∀ a : Fin 9, a.val * (8 - a.val) ≤ 16 := by decide
  exact checked ⟨a, by omega⟩

theorem same_parity_color_cut (a b : Nat) (hab : a % 2 = b % 2) :
    (((a + b + 1) / 2) % 36) % 2 ≠ a % 2 ↔
      (a / 2) % 2 ≠ (b / 2) % 2 := by
  omega


end Erdos811Q9UnanchoredScalar


