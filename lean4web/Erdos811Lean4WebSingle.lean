lemma nat_lt_twelve_cases (s : Nat) (hs : s < 12) :
    s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 ∨ s = 4 ∨ s = 5 ∨
      s = 6 ∨ s = 7 ∨ s = 8 ∨ s = 9 ∨ s = 10 ∨ s = 11 := by
  omega

lemma translate_counts_to_representative1 (x : Fin 9 → Nat) (s : Nat)
    (hs : s < 12)
    (hrot : representative1.drop s ++ representative1.take s = counts12 x) :
    counts12 (translateVertices x s) = representative1 := by
  rw [counts12_translate_components x s hs]
  rcases nat_lt_twelve_cases s hs with
    (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [representative1, counts12, count12_eq_count12Nat, Fin.ofNat] at hrot <;>
    rcases hrot with ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ <;>
    norm_num [shiftBack12, count12_eq_count12Nat, Fin.ofNat] <;>
    rw [← h0, ← h1, ← h2, ← h3, ← h4, ← h5, ← h6, ← h7,
      ← h8, ← h9, ← h10, ← h11] <;> simp [representative1, shiftBack12]

