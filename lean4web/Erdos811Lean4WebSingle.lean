/-! Conversion of the abstract mod-3 double count into the explicit
six-entry `good3` predicate used by the compact classifier. -/

namespace Erdos811Q9Good3Bridge

open Erdos811Q9DoubleCount Erdos811Q9FiniteCountBridge
open Erdos811Q9ResidueCounts

def count6 (x : Fin 9 → Nat) (r : Fin 6) : Nat :=
  (residueFiber (residue6 x) r).card

def counts6 (x : Fin 9 → Nat) : List Nat :=
  [count6 x 0, count6 x 1, count6 x 2,
    count6 x 3, count6 x 4, count6 x 5]

lemma counts6_length (x : Fin 9 → Nat) : (counts6 x).length = 6 := by
  simp [counts6]

lemma counts6_sum (x : Fin 9 → Nat) : (counts6 x).sum = 9 := by
  have h := Finset.sum_card_fiberwise_eq_card_filter
    (Finset.univ : Finset (Fin 9)) (Finset.univ : Finset (Fin 6)) (residue6 x)
  simpa [counts6, count6, Fin.sum_univ_succ, residueFiber] using h

lemma mul_pred_eq_twice_half (n : Nat) :
    n * (n - 1) = 2 * (n * (n - 1) / 2) := by
  rw [Nat.mul_comm 2, Nat.div_two_mul_two_of_even (Nat.even_mul_pred_self n)]

lemma half_equation0 {a b c d e f : Nat}
    (h :
      a * (a - 1) + a * f +
        (b * e + b * f +
          (c * d + c * e +
            (d * c + d * (d - 1) +
              (e * b + e * c + (f * a + f * b))))) = 24) :
    a * (a - 1) / 2 + a * f + b * e + b * f + c * d + c * e +
      d * (d - 1) / 2 = 12 := by
  rw [mul_pred_eq_twice_half a, mul_pred_eq_twice_half d,
    ] at h
  simp only [Nat.mul_comm] at h ⊢
  omega

lemma half_equation1 {a b c d e f : Nat}
    (h :
      a * b + a * c +
        (b * a + b * (b - 1) +
          (c * a + c * f +
            (d * e + d * f +
              (e * d + e * (e - 1) + (f * c + f * d))))) = 24) :
    a * b + a * c + b * (b - 1) / 2 + c * f + d * e + d * f +
      e * (e - 1) / 2 = 12 := by
  rw [mul_pred_eq_twice_half b, mul_pred_eq_twice_half e,
    ] at h
  simp only [Nat.mul_comm] at h ⊢
  omega

lemma half_equation2 {a b c d e f : Nat}
    (h :
      a * d + a * e +
        (b * c + b * d +
          (c * b + c * (c - 1) +
            (d * a + d * b +
              (e * a + e * f + (f * e + f * (f - 1)))))) = 24) :
    a * d + a * e + b * c + b * d + c * (c - 1) / 2 + e * f +
      f * (f - 1) / 2 = 12 := by
  rw [mul_pred_eq_twice_half c, mul_pred_eq_twice_half f,
    ] at h
  simp only [Nat.mul_comm] at h ⊢
  omega

theorem injective_edges_give_good3
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (hodd : count6 x 1 + count6 x 3 + count6 x 5 = 4 ∨
      count6 x 1 + count6 x 3 + count6 x 5 = 5) :
    good3 (counts6 x) = true := by
  have h0 := injective_edges_give_mod3_count_formula x hinj (0 : Fin 3)
  have h1 := injective_edges_give_mod3_count_formula x hinj (1 : Fin 3)
  have h2 := injective_edges_give_mod3_count_formula x hinj (2 : Fin 3)
  simp [Fin.sum_univ_succ, residueColor3, count6] at h0 h1 h2
  have e0 := half_equation0 h0
  have e1 := half_equation1 h1
  have e2 := half_equation2 h2
  have e0' := show
    count6 x 0 * (count6 x 0 - 1) / 2 + count6 x 0 * count6 x 5 +
      count6 x 1 * count6 x 4 + count6 x 1 * count6 x 5 +
      count6 x 2 * count6 x 3 + count6 x 2 * count6 x 4 +
      count6 x 3 * (count6 x 3 - 1) / 2 = 12 by
      simpa [count6] using e0
  have e1' := show
    count6 x 0 * count6 x 1 + count6 x 0 * count6 x 2 +
      count6 x 1 * (count6 x 1 - 1) / 2 + count6 x 2 * count6 x 5 +
      count6 x 3 * count6 x 4 + count6 x 3 * count6 x 5 +
      count6 x 4 * (count6 x 4 - 1) / 2 = 12 by
      simpa [count6] using e1
  have e2' := show
    count6 x 0 * count6 x 3 + count6 x 0 * count6 x 4 +
      count6 x 1 * count6 x 2 + count6 x 1 * count6 x 3 +
      count6 x 2 * (count6 x 2 - 1) / 2 + count6 x 4 * count6 x 5 +
      count6 x 5 * (count6 x 5 - 1) / 2 = 12 by
      simpa [count6] using e2
  simp [good3, counts6, hodd]
  exact ⟨⟨e0', e1'⟩, e2'⟩

theorem injective_edges_classified_mod3
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (hodd : count6 x 1 + count6 x 3 + count6 x 5 = 4 ∨
      count6 x 1 + count6 x 3 + count6 x 5 = 5) :
    counts6 x ∈ profiles3 := by
  apply classify3 (counts6 x) (counts6_length x) (counts6_sum x)
  exact injective_edges_give_good3 x hinj hodd

end Erdos811Q9Good3Bridge


