/-! A small, graph-independent parity obstruction for the finite q=9 case. -/

namespace Erdos811Q9OddCount

open Erdos811Q9UniformEdgeCounts Erdos811Q9FiniteCountBridge

lemma injective_color_sum_mod4 {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36) :
    ∑ a : A, ((f a).val : ZMod 4) = 2 := by
  have himage : Finset.univ.image f = (Finset.univ : Finset (Fin 36)) := by
    apply Finset.eq_univ_of_card
    rw [Finset.card_image_of_injective _ hf]
    simpa [hcard]
  calc
    (∑ a : A, ((f a).val : ZMod 4)) =
        Finset.sum ((Finset.univ : Finset A).image f)
          (fun c => ((c.val : Nat) : ZMod 4)) := by
      rw [Finset.sum_image]
      intro a ha b hb hab
      exact hf hab
    _ = ∑ c : Fin 36, ((c.val : Nat) : ZMod 4) := by rw [himage]
    _ = 2 := by decide +revert

lemma cast_mod36_zmod4 (n : Nat) :
    (((n % 36 : Nat) : ZMod 4)) = (n : ZMod 4) := by
  apply (ZMod.natCast_eq_natCast_iff' (n % 36) n 4).mpr
  exact Nat.mod_mod_of_dvd n (by decide : 4 ∣ 36)

lemma half_sum_formula (a b : Nat) :
    (a + b + 1) / 2 =
      (a + 1) / 2 + (b + 1) / 2 - (a % 2) * (b % 2) := by
  have ha : a % 2 = 0 ∨ a % 2 = 1 := by omega
  have hb : b % 2 = 0 ∨ b % 2 = 1 := by omega
  have habrep : a + b + 1 =
      2 * (a / 2 + b / 2) + (a % 2 + b % 2 + 1) := by omega
  rw [habrep]
  rcases ha with ha | ha <;> rcases hb with hb | hb <;>
    simp [ha, hb] <;> omega

lemma half_sum_formula_zmod4 (a b : Nat) :
    (((a + b + 1) / 2 : Nat) : ZMod 4) =
      (((a + 1) / 2 : Nat) : ZMod 4) +
      (((b + 1) / 2 : Nat) : ZMod 4) -
      (((a % 2) * (b % 2) : Nat) : ZMod 4) := by
  rw [half_sum_formula]
  rw [Nat.cast_sub]
  · simp only [Nat.cast_add, Nat.cast_mul]
  · have ha : a % 2 = 0 ∨ a % 2 = 1 := by omega
    have hb : b % 2 = 0 ∨ b % 2 = 1 := by omega
    have hapos : a % 2 = 1 → 0 < a := by
      intro h
      omega
    have hbpos : b % 2 = 1 → 0 < b := by
      intro h
      omega
    rcases ha with ha | ha <;> rcases hb with hb | hb <;>
      simp [ha, hb] <;> omega

lemma edge_endpoint_sum_zero (u : Fin 9 → ZMod 4) :
    (∑ p : {p // p ∈ edgePairs9}, (u p.1.1 + u p.1.2)) = 0 := by
  have hsub := Finset.sum_subtype (F := inferInstance)
    (p := fun p : Fin 9 × Fin 9 => p ∈ edgePairs9)
    edgePairs9 (fun _ => Iff.rfl)
    (fun p : Fin 9 × Fin 9 => u p.1 + u p.2)
  rw [← hsub]
  simp [edgePairs9, Fintype.sum_prod_type, Finset.sum_filter,
    Fin.sum_univ_succ]
  abel_nf
  have h8 : (8 : ZMod 4) = 0 := by decide
  simp [h8]

lemma injective_edge_parity_pair_sum (x : Fin 9 → Nat)
    (hinj : Function.Injective (finiteEdgeColor x)) :
    (∑ p : {p // p ∈ edgePairs9},
      (((x p.1.1 % 2) * (x p.1.2 % 2) : Nat) : ZMod 4)) = 2 := by
  have hsum := injective_color_sum_mod4 (finiteEdgeColor x) hinj edgePairs9_card
  change (∑ p : {p // p ∈ edgePairs9},
    ((Erdos811Q9ResidueArithmetic.edgeColor (x p.1.1) (x p.1.2) : Nat) : ZMod 4)) = 2 at hsum
  simp_rw [Erdos811Q9ResidueArithmetic.edgeColor, cast_mod36_zmod4,
    half_sum_formula_zmod4] at hsum
  have hlinear :
      (∑ p : {p // p ∈ edgePairs9},
        ((((x p.1.1 + 1) / 2 : Nat) : ZMod 4) +
          (((x p.1.2 + 1) / 2 : Nat) : ZMod 4))) = 0 := by
    exact edge_endpoint_sum_zero
      (fun i => (((x i + 1) / 2 : Nat) : ZMod 4))
  have hreduce :
      (∑ p : {p // p ∈ edgePairs9},
        ((((x p.1.1 + 1) / 2 : Nat) : ZMod 4) +
          (((x p.1.2 + 1) / 2 : Nat) : ZMod 4) -
          (((x p.1.1 % 2) * (x p.1.2 % 2) : Nat) : ZMod 4))) =
        -(∑ p : {p // p ∈ edgePairs9},
          (((x p.1.1 % 2) * (x p.1.2 % 2) : Nat) : ZMod 4)) := by
    rw [Finset.sum_sub_distrib, hlinear, zero_sub]
  rw [hreduce] at hsum
  linear_combination (norm := (ring_nf; reduce_mod_char)) -hsum

lemma pair_sum_square_identity (e : Fin 9 → Nat) :
    (∑ i : Fin 9, e i) * (∑ i : Fin 9, e i) =
      (∑ i : Fin 9, e i * e i) +
        2 * Finset.sum edgePairs9 (fun p => e p.1 * e p.2) := by
  simp [edgePairs9, Fintype.sum_prod_type, Finset.sum_filter, Fin.sum_univ_succ]
  ring

lemma parity_pattern_four_or_five (e : Fin 9 → Nat)
    (hbit : ∀ i, e i = 0 ∨ e i = 1) (he0 : e 0 = 0)
    (hp : (∑ p : {p // p ∈ edgePairs9},
      (((e p.1.1) * (e p.1.2) : Nat) : ZMod 4)) = 2) :
    (∑ i : Fin 9, e i) = 4 ∨ (∑ i : Fin 9, e i) = 5 := by
  have hsub := Finset.sum_subtype (F := inferInstance)
    (p := fun p : Fin 9 × Fin 9 => p ∈ edgePairs9)
    edgePairs9 (fun _ => Iff.rfl)
    (fun p : Fin 9 × Fin 9 => (((e p.1) * (e p.2) : Nat) : ZMod 4))
  rw [← hsub] at hp
  have hpNat :
      (Finset.sum edgePairs9 (fun p => (e p.1) * (e p.2))) % 4 = 2 := by
    apply (ZMod.natCast_eq_natCast_iff'
      (Finset.sum edgePairs9 (fun p => (e p.1) * (e p.2))) 2 4).mp
    simpa only [Nat.cast_sum, Nat.cast_mul, Nat.cast_ofNat] using hp
  have hsq (i : Fin 9) : e i * e i = e i := by
    rcases hbit i with hi | hi <;> simp [hi]
  have hsqsum : (∑ i : Fin 9, e i * e i) = ∑ i : Fin 9, e i := by
    apply Finset.sum_congr rfl
    intro i hi
    exact hsq i
  have hid := pair_sum_square_identity e
  rw [hsqsum] at hid
  have htwice :
      2 * Finset.sum edgePairs9 (fun p => e p.1 * e p.2) =
        (∑ i : Fin 9, e i) * ((∑ i : Fin 9, e i) - 1) := by
    rw [Nat.mul_sub_left_distrib]
    simp only [Nat.mul_one]
    omega
  have hpchoose : ((∑ i : Fin 9, e i).choose 2) % 4 = 2 := by
    rw [Nat.choose_two_right, ← htwice]
    simpa using hpNat
  have hle (i : Fin 9) : e i ≤ 1 := by
    rcases hbit i with hi | hi <;> omega
  have htotal : (∑ i : Fin 9, e i) ≤ 8 := by
    simp [Fin.sum_univ_succ, he0]
    have h1 := hle (1 : Fin 9)
    have h2 := hle (2 : Fin 9)
    have h3 := hle (3 : Fin 9)
    have h4 := hle (4 : Fin 9)
    have h5 := hle (5 : Fin 9)
    have h6 := hle (6 : Fin 9)
    have h7 := hle (7 : Fin 9)
    have h8 := hle (8 : Fin 9)
    omega
  interval_cases hs : (∑ i : Fin 9, e i)
  all_goals norm_num [Nat.choose_two_right, hs] at hpchoose
  all_goals omega

theorem odd_vertices_four_or_five (x : Fin 9 → Nat) (hx0 : x 0 = 0)
    (hinj : Function.Injective (finiteEdgeColor x)) :
    (∑ i : Fin 9, x i % 2) = 4 ∨ (∑ i : Fin 9, x i % 2) = 5 := by
  apply parity_pattern_four_or_five (fun i => x i % 2)
  · intro i
    omega
  · simp [hx0]
  · exact injective_edge_parity_pair_sum x hinj

/-! The zero anchor is unnecessary.  The same colour-sum congruence gives
`choose r 2 ≡ 2 (mod 4)` and the full range `0 ≤ r ≤ 9` still leaves only
`r = 4,5`. -/

lemma parity_pattern_four_or_five_unanchored (e : Fin 9 → Nat)
    (hbit : ∀ i, e i = 0 ∨ e i = 1)
    (hp : (∑ p : {p // p ∈ edgePairs9},
      (((e p.1.1) * (e p.1.2) : Nat) : ZMod 4)) = 2) :
    (∑ i : Fin 9, e i) = 4 ∨ (∑ i : Fin 9, e i) = 5 := by
  have hsub := Finset.sum_subtype (F := inferInstance)
    (p := fun p : Fin 9 × Fin 9 => p ∈ edgePairs9)
    edgePairs9 (fun _ => Iff.rfl)
    (fun p : Fin 9 × Fin 9 => (((e p.1) * (e p.2) : Nat) : ZMod 4))
  rw [← hsub] at hp
  have hpNat :
      (Finset.sum edgePairs9 (fun p => e p.1 * e p.2)) % 4 = 2 := by
    apply (ZMod.natCast_eq_natCast_iff'
      (Finset.sum edgePairs9 (fun p => e p.1 * e p.2)) 2 4).mp
    simpa only [Nat.cast_sum, Nat.cast_mul, Nat.cast_ofNat] using hp
  have hsq (i : Fin 9) : e i * e i = e i := by
    rcases hbit i with hi | hi <;> simp [hi]
  have hsqsum : (∑ i : Fin 9, e i * e i) = ∑ i : Fin 9, e i := by
    apply Finset.sum_congr rfl
    intro i hi
    exact hsq i
  have hid := pair_sum_square_identity e
  rw [hsqsum] at hid
  have htwice :
      2 * Finset.sum edgePairs9 (fun p => e p.1 * e p.2) =
        (∑ i : Fin 9, e i) * ((∑ i : Fin 9, e i) - 1) := by
    rw [Nat.mul_sub_left_distrib]
    simp only [Nat.mul_one]
    omega
  have hpchoose : ((∑ i : Fin 9, e i).choose 2) % 4 = 2 := by
    rw [Nat.choose_two_right, ← htwice]
    simpa using hpNat
  have hle (i : Fin 9) : e i ≤ 1 := by
    rcases hbit i with hi | hi <;> omega
  have htotal : (∑ i : Fin 9, e i) ≤ 9 := by
    exact Finset.sum_le_card_nsmul Finset.univ e 1
      (by intro i hi; exact hle i)
  rw [Nat.choose_two_right] at hpchoose
  exact Erdos811Q9UnanchoredScalar.finite_parity_candidates
    (∑ i : Fin 9, e i) htotal hpchoose

theorem odd_vertices_four_or_five_unanchored (x : Fin 9 → Nat)
    (hinj : Function.Injective (finiteEdgeColor x)) :
    (∑ i : Fin 9, x i % 2) = 4 ∨ (∑ i : Fin 9, x i % 2) = 5 := by
  apply parity_pattern_four_or_five_unanchored (fun i => x i % 2)
  · intro i
    omega
  · exact injective_edge_parity_pair_sum x hinj

end Erdos811Q9OddCount


