/-! BEGIN BUNDLED MODULE: Q9Good6DirectBridge -/


/-! A compact direct mod-6 classifier.

Instead of expanding the six directed colour-count identities into six long
polynomials, the checker evaluates those identities directly on each split of
the six already-classified mod-3 profiles. -/

namespace Erdos811Q9Good6Bridge

open Erdos811Q9DoubleCount Erdos811Q9FiniteCountBridge
open Erdos811Q9ResidueCounts Erdos811Q9Good3Bridge

def liftLow (r : Fin 6) : Fin 12 :=
  ⟨r.val, Nat.lt_trans r.isLt (by decide)⟩

def liftHigh (r : Fin 6) : Fin 12 :=
  ⟨r.val + 6, by omega⟩

lemma mod6_eq_iff_mod12_eq_or_eq_add6 (a : Nat) (r : Fin 6) :
    a % 6 = r.val ↔ a % 12 = r.val ∨ a % 12 = r.val + 6 := by
  have hs : a % 12 < 12 := Nat.mod_lt _ (by decide)
  have hm : (a % 12) % 6 = a % 6 :=
    Nat.mod_mod_of_dvd a (by decide : 6 ∣ 12)
  constructor <;> intro h <;> omega

lemma residueFiber6_split (x : Fin 9 → Nat) (r : Fin 6) :
    residueFiber (residue6 x) r =
      residueFiber (residue12 x) (liftLow r) ∪
        residueFiber (residue12 x) (liftHigh r) := by
  ext i
  simp only [residueFiber, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_union]
  simp only [residue6, residue12, liftLow, liftHigh, Fin.ext_iff]
  exact mod6_eq_iff_mod12_eq_or_eq_add6 (x i) r

lemma residueFiber12_lifts_disjoint (x : Fin 9 → Nat) (r : Fin 6) :
    Disjoint (residueFiber (residue12 x) (liftLow r))
      (residueFiber (residue12 x) (liftHigh r)) := by
  rw [Finset.disjoint_left]
  intro i hlo hhi
  have hlo' := congrArg Fin.val (Finset.mem_filter.mp hlo).2
  have hhi' := congrArg Fin.val (Finset.mem_filter.mp hhi).2
  simp only [residue12, liftLow, liftHigh] at hlo' hhi'
  omega

lemma count6_eq_count12_add (x : Fin 9 → Nat) (r : Fin 6) :
    count6 x r = count12 x (liftLow r) + count12 x (liftHigh r) := by
  simp only [count6, count12]
  rw [residueFiber6_split x r,
    Finset.card_union_of_disjoint (residueFiber12_lifts_disjoint x r)]

def splitProfile (x : Fin 9 → Nat) : List (Nat × Nat) :=
  [(count12 x 0, count12 x 6), (count12 x 1, count12 x 7),
    (count12 x 2, count12 x 8), (count12 x 3, count12 x 9),
    (count12 x 4, count12 x 10), (count12 x 5, count12 x 11)]

lemma splitProfile_coarse (x : Fin 9 → Nat) :
    (splitProfile x).map (fun ab => ab.1 + ab.2) = counts6 x := by
  simp only [splitProfile, List.map_cons, List.map_nil, counts6]
  rw [count6_eq_count12_add x 0, count6_eq_count12_add x 1,
    count6_eq_count12_add x 2, count6_eq_count12_add x 3,
    count6_eq_count12_add x 4, count6_eq_count12_add x 5]
  rfl

def fineList (ps : List (Nat × Nat)) : List Nat :=
  ps.map Prod.fst ++ ps.map Prod.snd

lemma fineList_splitProfile (x : Fin 9 → Nat) :
    fineList (splitProfile x) = counts12 x := by
  rfl

def fineCounts (ps : List (Nat × Nat)) (r : Fin 12) : Nat :=
  (fineList ps).getD r.val 0

lemma counts12_getD (x : Fin 9 → Nat) (r : Fin 12) :
    (counts12 x).getD r.val 0 = count12 x r := by
  fin_cases r <;> rfl

lemma fineCounts_splitProfile (x : Fin 9 → Nat) :
    fineCounts (splitProfile x) = count12 x := by
  funext r
  simp only [fineCounts, fineList_splitProfile, counts12_getD]

def directedColorCount6 (ps : List (Nat × Nat)) (c : Fin 6) : Nat :=
  ∑ a : Fin 12, ∑ b : Fin 12,
    if residueColor6 a b = c then
      if a = b then
        fineCounts ps a * (fineCounts ps a - 1)
      else fineCounts ps a * fineCounts ps b
    else 0

def Good6Direct (ps : List (Nat × Nat)) : Prop :=
  (fineCounts ps 1 + fineCounts ps 3 + fineCounts ps 5 +
        fineCounts ps 7 + fineCounts ps 9 + fineCounts ps 11 = 4 ∨
    fineCounts ps 1 + fineCounts ps 3 + fineCounts ps 5 +
        fineCounts ps 7 + fineCounts ps 9 + fineCounts ps 11 = 5) ∧
  directedColorCount6 ps 0 = 12 ∧
  directedColorCount6 ps 1 = 12 ∧
  directedColorCount6 ps 2 = 12 ∧
  directedColorCount6 ps 3 = 12 ∧
  directedColorCount6 ps 4 = 12 ∧
  directedColorCount6 ps 5 = 12

instance good6DirectDecidable (ps : List (Nat × Nat)) :
    Decidable (Good6Direct ps) := by
  unfold Good6Direct
  infer_instance

def accept6Direct (ps : List (Nat × Nat)) : Bool :=
  !decide (Good6Direct ps) || decide (fineList ps ∈ profiles6)

set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

theorem refineDirect0 :
    refinementsCheck [1, 1, 2, 1, 2, 2] accept6Direct = true := by
  decide +revert

theorem refineDirect1 :
    refinementsCheck [1, 2, 1, 2, 2, 1] accept6Direct = true := by
  decide +revert

theorem refineDirect2 :
    refinementsCheck [1, 2, 2, 1, 1, 2] accept6Direct = true := by
  decide +revert

theorem refineDirect3 :
    refinementsCheck [2, 1, 1, 2, 1, 2] accept6Direct = true := by
  decide +revert

theorem refineDirect4 :
    refinementsCheck [2, 1, 2, 2, 1, 1] accept6Direct = true := by
  decide +revert

theorem refineDirect5 :
    refinementsCheck [2, 2, 1, 1, 2, 1] accept6Direct = true := by
  decide +revert

theorem check6Direct :
    profiles3.all (fun ns => refinementsCheck ns accept6Direct) = true := by
  simp [profiles3, refineDirect0, refineDirect1, refineDirect2,
    refineDirect3, refineDirect4, refineDirect5]

theorem classify6Direct (ps : List (Nat × Nat))
    (hcoarse : ps.map (fun ab => ab.1 + ab.2) ∈ profiles3)
    (hgood : Good6Direct ps) : fineList ps ∈ profiles6 := by
  have hcheck := (List.all_eq_true.mp check6Direct) _ hcoarse
  have h := refinementsCheck_sound ps accept6Direct hcheck
  simpa [accept6Direct, hgood] using h

theorem injective_edges_classified_mod6
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (hodd : count12 x 1 + count12 x 3 + count12 x 5 + count12 x 7 +
        count12 x 9 + count12 x 11 = 4 ∨
      count12 x 1 + count12 x 3 + count12 x 5 + count12 x 7 +
        count12 x 9 + count12 x 11 = 5) :
    counts12 x ∈ profiles6 := by
  have hodd6 : count6 x 1 + count6 x 3 + count6 x 5 = 4 ∨
      count6 x 1 + count6 x 3 + count6 x 5 = 5 := by
    rw [count6_eq_count12_add x 1, count6_eq_count12_add x 3,
      count6_eq_count12_add x 5]
    rw [show liftLow (1 : Fin 6) = (1 : Fin 12) by decide,
      show liftHigh (1 : Fin 6) = (7 : Fin 12) by decide,
      show liftLow (3 : Fin 6) = (3 : Fin 12) by decide,
      show liftHigh (3 : Fin 6) = (9 : Fin 12) by decide,
      show liftLow (5 : Fin 6) = (5 : Fin 12) by decide,
      show liftHigh (5 : Fin 6) = (11 : Fin 12) by decide]
    rcases hodd with h4 | h5
    · left
      omega
    · right
      omega
  have hcoarse :
      (splitProfile x).map (fun ab => ab.1 + ab.2) ∈ profiles3 := by
    rw [splitProfile_coarse]
    exact injective_edges_classified_mod3 x hinj hodd6
  have hgood : Good6Direct (splitProfile x) := by
    constructor
    · simpa only [fineCounts_splitProfile] using hodd
    · have hformula (c : Fin 6) :
          directedColorCount6 (splitProfile x) c = 12 := by
        simp only [directedColorCount6, fineCounts_splitProfile]
        exact injective_edges_give_mod6_count_formula x hinj c
      exact ⟨hformula 0, hformula 1, hformula 2,
        hformula 3, hformula 4, hformula 5⟩
  have hfine := classify6Direct (splitProfile x) hcoarse hgood
  simpa only [fineList_splitProfile] using hfine

end Erdos811Q9Good6Bridge


