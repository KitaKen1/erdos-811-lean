def accept3 (xs : List Nat) : Bool := !good3 xs || decide (xs ∈ profiles3)

def accept6 (ps : List (Nat × Nat)) : Bool :=
  let xs := ps.map Prod.fst ++ ps.map Prod.snd
  !good6 xs || decide (xs ∈ profiles6)

set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

theorem check3 : compositionsCheck 6 9 accept3 = true := by decide +revert

theorem classify3 (xs : List Nat) (hlen : xs.length = 6) (hsum : xs.sum = 9)
    (hgood : good3 xs = true) : xs ∈ profiles3 := by
  have hcheck : compositionsCheck xs.length xs.sum accept3 = true := by
    simpa only [hlen, hsum] using check3
  have h := compositionsCheck_sound xs accept3 hcheck
  simpa [accept3, hgood] using h

theorem refine0 : refinementsCheck [1, 1, 2, 1, 2, 2] accept6 = true := by
  decide +revert

theorem refine1 : refinementsCheck [1, 2, 1, 2, 2, 1] accept6 = true := by
  decide +revert

theorem refine2 : refinementsCheck [1, 2, 2, 1, 1, 2] accept6 = true := by
  decide +revert

theorem refine3 : refinementsCheck [2, 1, 1, 2, 1, 2] accept6 = true := by
  decide +revert

theorem refine4 : refinementsCheck [2, 1, 2, 2, 1, 1] accept6 = true := by
  decide +revert

