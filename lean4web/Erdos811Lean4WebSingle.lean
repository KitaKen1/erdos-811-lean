/-! BEGIN BUNDLED MODULE: Q9UniformEdgeCounts -/


/-! Rainbow injectivity turns the 36 q=9 edges into a permutation of
`Fin 36`.  Hence every residue modulo 3 occurs 12 times and every residue
modulo 6 occurs 6 times.  This file proves that bridge without the q=9
colouring definitions. -/

open scoped BigOperators

namespace Erdos811Q9UniformEdgeCounts

lemma injective_predicate_count {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36)
    (P : Fin 36 → Prop) [DecidablePred P] :
    (Finset.univ.filter fun a : A => P (f a)).card =
      (Finset.univ.filter P).card := by
  let source : Finset A := Finset.univ.filter fun a => P (f a)
  let target : Finset (Fin 36) := Finset.univ.filter P
  have himage : Finset.univ.image f = (Finset.univ : Finset (Fin 36)) := by
    apply Finset.eq_univ_of_card
    rw [Finset.card_image_of_injective _ hf]
    simpa [hcard]
  have hsource_image : source.image f = target := by
    ext c
    constructor
    · intro hc
      rcases Finset.mem_image.mp hc with ⟨a, ha, rfl⟩
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, (Finset.mem_filter.mp ha).2⟩
    · intro hc
      have hc_all : c ∈ Finset.univ.image f := by simpa [himage] using hc
      rcases Finset.mem_image.mp hc_all with ⟨a, _, ha⟩
      have hcP : P c := (Finset.mem_filter.mp hc).2
      have haP : P (f a) := by simpa [ha] using hcP
      exact Finset.mem_image.mpr
        ⟨a, Finset.mem_filter.mpr ⟨Finset.mem_univ _, haP⟩, ha⟩
  have hcards : source.card = target.card := by
    rw [← hsource_image]
    exact Finset.card_image_of_injective source hf |>.symm
  exact hcards

lemma fin36_mod3_count : ∀ c : Fin 3,
    (Finset.univ.filter fun z : Fin 36 => z.val % 3 = c.val).card = 12 := by
  decide +revert

lemma fin36_mod6_count : ∀ c : Fin 6,
    (Finset.univ.filter fun z : Fin 36 => z.val % 6 = c.val).card = 6 := by
  decide +revert

lemma injective_mod3_count {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36) (c : Fin 3) :
    (Finset.univ.filter fun a : A => (f a).val % 3 = c.val).card = 12 := by
  exact (injective_predicate_count f hf hcard
    (fun z : Fin 36 => z.val % 3 = c.val)).trans (fin36_mod3_count c)

lemma injective_mod6_count {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36) (c : Fin 6) :
    (Finset.univ.filter fun a : A => (f a).val % 6 = c.val).card = 6 := by
  exact (injective_predicate_count f hf hcard
    (fun z : Fin 36 => z.val % 6 = c.val)).trans (fin36_mod6_count c)

def edgePairs9 : Finset (Fin 9 × Fin 9) :=
  (Finset.univ.product Finset.univ).filter fun p => p.1 < p.2

lemma edgePairs9_card : edgePairs9.card = 36 := by decide +revert

lemma subtype_filter_card (P : Fin 9 × Fin 9 → Prop) [DecidablePred P] :
    (Finset.univ.filter fun p : {p // p ∈ edgePairs9} => P p.1).card =
      (edgePairs9.filter P).card := by
  apply Finset.card_bij (fun p _ => p.1)
  · intro p hp
    exact Finset.mem_filter.mpr ⟨p.2, (Finset.mem_filter.mp hp).2⟩
  · intro p hp q hq hpq
    exact Subtype.ext hpq
  · intro p hp
    refine ⟨⟨p, (Finset.mem_filter.mp hp).1⟩, ?_, rfl⟩
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_univ _, (Finset.mem_filter.mp hp).2⟩

end Erdos811Q9UniformEdgeCounts


