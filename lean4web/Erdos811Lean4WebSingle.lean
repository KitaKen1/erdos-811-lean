theorem profile1_impossible (a b c d e f g h i : ZMod 3)
    (s0 : (a + h + 1) + (b + h + 1) + (c + g + 1) + (d + g + 1) + (e + f + 1) + (e + g + 1) = 0)
    (s1 : (a + i + 1) + (b + i + 1) + (c + h + 1) + (d + h + 1) + (e + h + 1) + (f + g + 1) = 0)
    (s2 : (a + b) + (c + i + 1) + (d + i + 1) + (e + i + 1) + (f + h + 1) + (g + h + 1) = 0)
    (s3 : (a + c) + (a + d) + (b + c) + (b + d) + (f + i + 1) + (g + i + 1) = 0)
    (s4 : (a + e) + (a + f) + (b + e) + (b + f) + (c + d) + (h + i + 1) = 0)
    (s5 : (a + g) + (b + g) + (c + e) + (c + f) + (d + e) + (d + f) = 0)
    (t0 : (a + h + 1) ^ 2 + (b + h + 1) ^ 2 + (c + g + 1) ^ 2 + (d + g + 1) ^ 2 + (e + f + 1) ^ 2 + (e + g + 1) ^ 2 = 1)
    (t1 : (a + i + 1) ^ 2 + (b + i + 1) ^ 2 + (c + h + 1) ^ 2 + (d + h + 1) ^ 2 + (e + h + 1) ^ 2 + (f + g + 1) ^ 2 = 1)
    (t2 : (a + b) ^ 2 + (c + i + 1) ^ 2 + (d + i + 1) ^ 2 + (e + i + 1) ^ 2 + (f + h + 1) ^ 2 + (g + h + 1) ^ 2 = 1)
    (t3 : (a + c) ^ 2 + (a + d) ^ 2 + (b + c) ^ 2 + (b + d) ^ 2 + (f + i + 1) ^ 2 + (g + i + 1) ^ 2 = 1)
    (t4 : (a + e) ^ 2 + (a + f) ^ 2 + (b + e) ^ 2 + (b + f) ^ 2 + (c + d) ^ 2 + (h + i + 1) ^ 2 = 1)
    (t5 : (a + g) ^ 2 + (b + g) ^ 2 + (c + e) ^ 2 + (c + f) ^ 2 + (d + e) ^ 2 + (d + f) ^ 2 = 1)
    : False := by
  have ha : a = 0 - b - i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s1 + s3 + s4
  have hc : c = 0 - d - 2 * g - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s2 + 2 * s4
  have he : e = 2 - 2 * g := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s2
  have hf : f = 1 - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s1 + 2 * s2 + 2 * s3
  have hh : h = 2 - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s1 + 2 * s2
  simp only [ha, hc, he, hf, hh] at t0 t1 t2 t3 t4 t5
  have bad : (0 : ZMod 3) = 1 := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * t1 + 2 * t2 + t3 + t4
  norm_num at bad

