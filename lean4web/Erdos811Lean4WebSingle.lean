    ((s.orderEmbOfFin hs_card).lt_iff_lt.mpr (by decide))
    ((s.orderEmbOfFin hs_card).lt_iff_lt.mpr (by decide))
    ((s.orderEmbOfFin hs_card).lt_iff_lt.mpr (by decide)) hnat


