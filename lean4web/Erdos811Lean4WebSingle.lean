/-! The first two moments of the colour quotients in every residue class.
For a rainbow `K_9`, each class modulo 6 consists of the six colours
`c, c+6, ..., c+30`, whose quotients modulo 3 have sum 0 and square-sum 1.
-/

open scoped BigOperators

namespace Erdos811Q9EdgeMoments

open Erdos811Q9UniformEdgeCounts

def quotient3 (z : Fin 36) : ZMod 3 := ((z.val / 6 : Nat) : ZMod 3)

lemma injective_predicate_sum {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36)
    (P : Fin 36 → Prop) [DecidablePred P]
    (w : Fin 36 → ZMod 3) :
    (∑ a ∈ Finset.univ.filter (fun a : A => P (f a)), w (f a)) =
      ∑ z ∈ Finset.univ.filter P, w z := by
  let source : Finset A := Finset.univ.filter fun a => P (f a)
  let target : Finset (Fin 36) := Finset.univ.filter P
  have himage : Finset.univ.image f = (Finset.univ : Finset (Fin 36)) := by
    apply Finset.eq_univ_of_card
    rw [Finset.card_image_of_injective _ hf]
    simpa [hcard]
  have hsource_image : source.image f = target := by
    ext c
    constructor
    · intro hc
      rcases Finset.mem_image.mp hc with ⟨a, ha, rfl⟩
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, (Finset.mem_filter.mp ha).2⟩
    · intro hc
      have hc_all : c ∈ Finset.univ.image f := by simpa [himage] using hc
      rcases Finset.mem_image.mp hc_all with ⟨a, _, ha⟩
      have hcP : P c := (Finset.mem_filter.mp hc).2
      have haP : P (f a) := by simpa [ha] using hcP
      exact Finset.mem_image.mpr
        ⟨a, Finset.mem_filter.mpr ⟨Finset.mem_univ _, haP⟩, ha⟩
  calc
    (∑ a ∈ source, w (f a)) = ∑ z ∈ source.image f, w z := by
      rw [Finset.sum_image]
      intro a ha b hb hab
      exact hf hab
    _ = ∑ z ∈ target, w z := by rw [hsource_image]

lemma fin36_quotient_sum : ∀ c : Fin 6,
    (∑ z ∈ Finset.univ.filter (fun z : Fin 36 => z.val % 6 = c.val),
      quotient3 z) = 0 := by
  decide +revert

lemma fin36_quotient_square_sum : ∀ c : Fin 6,
    (∑ z ∈ Finset.univ.filter (fun z : Fin 36 => z.val % 6 = c.val),
      (quotient3 z) ^ 2) = 1 := by
  decide +revert

theorem injective_quotient_sum {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36) (c : Fin 6) :
    (∑ a ∈ Finset.univ.filter (fun a : A => (f a).val % 6 = c.val),
      quotient3 (f a)) = 0 := by
  exact (injective_predicate_sum f hf hcard
    (fun z => z.val % 6 = c.val) quotient3).trans (fin36_quotient_sum c)

theorem injective_quotient_square_sum {A : Type*} [Fintype A]
    (f : A → Fin 36) (hf : Function.Injective f)
    (hcard : Fintype.card A = 36) (c : Fin 6) :
    (∑ a ∈ Finset.univ.filter (fun a : A => (f a).val % 6 = c.val),
      (quotient3 (f a)) ^ 2) = 1 := by
  exact (injective_predicate_sum f hf hcard
    (fun z => z.val % 6 = c.val) (fun z => (quotient3 z) ^ 2)).trans
      (fin36_quotient_square_sum c)

lemma subtype_filter_sum {A : Type*} [DecidableEq A]
    (s : Finset A) (P : A → Prop) [DecidablePred P]
    (w : A → ZMod 3) :
    (∑ a ∈ Finset.univ.filter (fun a : {a // a ∈ s} => P a.1), w a.1) =
      ∑ a ∈ s.filter P, w a := by
  let source : Finset {a // a ∈ s} :=
    Finset.univ.filter fun a => P a.1
  let target : Finset A := s.filter P
  have himage : source.image Subtype.val = target := by
    ext a
    constructor
    · intro ha
      rcases Finset.mem_image.mp ha with ⟨b, hb, rfl⟩
      exact Finset.mem_filter.mpr ⟨b.2, (Finset.mem_filter.mp hb).2⟩
    · intro ha
      refine Finset.mem_image.mpr ⟨⟨a, (Finset.mem_filter.mp ha).1⟩, ?_, rfl⟩
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, (Finset.mem_filter.mp ha).2⟩
  calc
    (∑ a ∈ source, w a.1) = ∑ a ∈ source.image Subtype.val, w a := by
      rw [Finset.sum_image]
      intro a ha b hb hab
      exact Subtype.ext hab
    _ = ∑ a ∈ target, w a := by rw [himage]

end Erdos811Q9EdgeMoments


