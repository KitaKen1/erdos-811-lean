  rw [counts12_translate_components x s hs]
  rcases nat_lt_twelve_cases s hs with
    (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [representative2, counts12, count12_eq_count12Nat, Fin.ofNat] at hrot <;>
    rcases hrot with ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ <;>
    norm_num [shiftBack12, count12_eq_count12Nat, Fin.ofNat] <;>
    rw [← h0, ← h1, ← h2, ← h3, ← h4, ← h5, ← h6, ← h7,
      ← h8, ← h9, ← h10, ← h11] <;> simp [representative2, shiftBack12]

lemma translate_counts_to_representative3 (x : Fin 9 → Nat) (s : Nat)
    (hs : s < 12)
    (hrot : representative3.drop s ++ representative3.take s = counts12 x) :
    counts12 (translateVertices x s) = representative3 := by
  rw [counts12_translate_components x s hs]
  rcases nat_lt_twelve_cases s hs with
    (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [representative3, counts12, count12_eq_count12Nat, Fin.ofNat] at hrot <;>
    rcases hrot with ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ <;>
    norm_num [shiftBack12, count12_eq_count12Nat, Fin.ofNat] <;>
