theorem q8Infinity_mod14_of_nodup (x : Fin 7 → Nat)
    (hfin : ∀ i, x i < 56)
    (hnd : (q8FinitePairColors (q8WithInfinity x)).Nodup) :
    q8VertexSumNat x % 14 =
      (q8ParitySumNat x * q8ParitySumNat x) % 14 := by
  let B : Nat := (q8Pairs7.map (fun ij => q8B7 x ij)).sum
  let P : Nat := (q8Pairs7.map (fun ij =>
    (x ij.1 % 2) * (x ij.2 % 2))).sum
  let s : Nat := q8CeilHalfSumNat x
  let X : Nat := q8VertexSumNat x
  let r : Nat := q8ParitySumNat x
  have hr : r ≤ 7 := by
    dsimp [r, q8ParitySumNat]
    omega
  have hrel : 2 * s = X + r := by
    dsimp [s, X, r]
    simpa [q8CeilHalfSumNat, q8VertexSumNat, q8ParitySumNat] using
      (q8CeilHalf_relation x).symm
  have hP : P = Nat.choose r 2 := by
    dsimp [P, r]
    simpa [q8ParitySumNat] using q8ParityProduct_sum_choose x
  have hBA : B + P = 6 * s := by
    dsimp [B, P, s]
    simpa [q8CeilHalfSumNat] using q8B7_sum_add_product x
  have hactual :
      ((q8FinitePairColors (q8WithInfinity x)).map (fun c => c.val)).sum % 7 = 0 := by
    rw [q8FinitePairColors_sum (q8WithInfinity x) hnd]
  have hmod := q8InfinityColorSum_mod7 x hfin
  have hraw0 : (q8Pairs.map (q8InfinityRawB x)).sum % 7 = 0 := by
    have hm :
        ((q8FinitePairColors (q8WithInfinity x)).map (fun c => c.val)).sum % 7 =
          (q8Pairs.map (q8InfinityRawB x)).sum % 7 := by
      simpa [Nat.ModEq] using hmod
    omega
  have hraw_eq :
      (q8Pairs.map (q8InfinityRawB x)).sum = B + X := by
    dsimp [B, X]
    simpa [q8VertexSumNat] using q8InfinityRawB_sum x
  have hsumBX : (B + X) % 7 = 0 := by
    rw [← hraw_eq]
    exact hraw0
  have hcol : (8 * s - (r + P)) % 7 = 0 :=
    q8_raw_sum_to_color_sum_condition r s X P B hr hrel hP hBA hsumBX
  have hcol' : (8 * s - (r + Nat.choose r 2)) % 7 = 0 := by
