/-! Minimal versions of the four abstract ZMod-3 contradictions,
retaining only the moment equations actually used by their proofs. -/

namespace Erdos811Q9CompactUsedMoments

theorem profile1_used (a b c d e f g h i : ZMod 3)
    (s0 : (a + h + 1) + (b + h + 1) + (c + g + 1) + (d + g + 1) + (e + f + 1) + (e + g + 1) = 0)
    (s1 : (a + i + 1) + (b + i + 1) + (c + h + 1) + (d + h + 1) + (e + h + 1) + (f + g + 1) = 0)
    (s2 : (a + b) + (c + i + 1) + (d + i + 1) + (e + i + 1) + (f + h + 1) + (g + h + 1) = 0)
    (s3 : (a + c) + (a + d) + (b + c) + (b + d) + (f + i + 1) + (g + i + 1) = 0)
    (s4 : (a + e) + (a + f) + (b + e) + (b + f) + (c + d) + (h + i + 1) = 0)
    (t1 : (a + i + 1) ^ 2 + (b + i + 1) ^ 2 + (c + h + 1) ^ 2 + (d + h + 1) ^ 2 + (e + h + 1) ^ 2 + (f + g + 1) ^ 2 = 1)
    (t2 : (a + b) ^ 2 + (c + i + 1) ^ 2 + (d + i + 1) ^ 2 + (e + i + 1) ^ 2 + (f + h + 1) ^ 2 + (g + h + 1) ^ 2 = 1)
    (t3 : (a + c) ^ 2 + (a + d) ^ 2 + (b + c) ^ 2 + (b + d) ^ 2 + (f + i + 1) ^ 2 + (g + i + 1) ^ 2 = 1)
    (t4 : (a + e) ^ 2 + (a + f) ^ 2 + (b + e) ^ 2 + (b + f) ^ 2 + (c + d) ^ 2 + (h + i + 1) ^ 2 = 1) : False := by
  have ha : a = 0 - b - i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s1 + s3 + s4
  have hc : c = 0 - d - 2 * g - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s2 + 2 * s4
  have he : e = 2 - 2 * g := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s2
  have hf : f = 1 - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + 2 * s1 + 2 * s2 + 2 * s3
  have hh : h = 2 - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s1 + 2 * s2
  simp only [ha, hc, he, hf, hh] at t1 t2 t3 t4
  have bad : (0 : ZMod 3) = 1 := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * t1 + 2 * t2 + t3 + t4
  norm_num at bad

theorem profile2_used (a b c d e f g h i : ZMod 3)
    (s1 : (a + i + 1) + (b + i + 1) + (c + h + 1) + (c + i + 1) + (d + f + 1) + (e + f + 1) = 0)
    (s3 : (a + c) + (b + c) + (d + i + 1) + (e + i + 1) + (f + h + 1) + (f + i + 1) = 0) : False := by
  have bad : (0 : ZMod 3) = 1 := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s1 + 2 * s3
  norm_num at bad

theorem profile3_used (a b c d e f g h i : ZMod 3)
    (s0 : (a + h + 1) + (a + i + 1) + (b + f + 1) + (b + g + 1) + (c + e + 1) + (c + f + 1) = 0)
    (s1 : (b + h + 1) + (b + i + 1) + (c + g + 1) + (c + h + 1) + (d + e + 1) + (d + f + 1) = 0)
    (s2 : (a + b) + (c + i + 1) + (d + g + 1) + (d + h + 1) + (e + f + 1) + (e + g + 1) = 0)
    (s3 : (a + c) + (d + i + 1) + (e + h + 1) + (e + i + 1) + (f + g + 1) + (f + h + 1) = 0)
    (s4 : (a + d) + (a + e) + (b + c) + (f + i + 1) + (g + h + 1) + (g + i + 1) = 0)
    (s5 : (a + f) + (a + g) + (b + d) + (b + e) + (c + d) + (h + i + 1) = 0)
    (t1 : (b + h + 1) ^ 2 + (b + i + 1) ^ 2 + (c + g + 1) ^ 2 + (c + h + 1) ^ 2 + (d + e + 1) ^ 2 + (d + f + 1) ^ 2 = 1)
    (t2 : (a + b) ^ 2 + (c + i + 1) ^ 2 + (d + g + 1) ^ 2 + (d + h + 1) ^ 2 + (e + f + 1) ^ 2 + (e + g + 1) ^ 2 = 1)
    (t4 : (a + d) ^ 2 + (a + e) ^ 2 + (b + c) ^ 2 + (f + i + 1) ^ 2 + (g + h + 1) ^ 2 + (g + i + 1) ^ 2 = 1)
    (t5 : (a + f) ^ 2 + (a + g) ^ 2 + (b + d) ^ 2 + (b + e) ^ 2 + (c + d) ^ 2 + (h + i + 1) ^ 2 = 1) : False := by
  have ha : a = 1 - g - i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + s1 + s2 + s3 + 2 * s4 + s5
  have hb : b = 0 - 2 * g - 2 * h - i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s0 + s2 + 2 * s4 + s5
  have hc : c = 0 - 2 * g - h - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s0 + 2 * s2 + 2 * s3 + s4 + s5
  have hd : d = 2 - h - i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s0 + 2 * s2
  have he : e = 0 - g - 2 * h - 2 * i := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s0 + s1 + s3 + s4 + s5
  have hf : f = 2 - g - h := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * s2 + s3 + 2 * s4 + s5
  simp only [ha, hb, hc, hd, he, hf] at t1 t2 t4 t5
  have bad : (0 : ZMod 3) = 1 := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) 2 * t1 + 2 * t2 + t4 + t5
  norm_num at bad

theorem profile4_used (a b c d e f g h i : ZMod 3)
    (s3 : (a + c) + (a + d) + (b + c) + (e + i + 1) + (f + g + 1) + (f + h + 1) = 0)
    (s5 : (a + f) + (a + g) + (b + f) + (c + d) + (c + e) + (h + i + 1) = 0) : False := by
  have bad : (0 : ZMod 3) = 1 := by
    linear_combination (norm := (ring_nf; reduce_mod_char)) s3 + 2 * s5
  norm_num at bad

end Erdos811Q9CompactUsedMoments


