lemma q8_count_obstruction (n0 n1 n2 n3 : Nat)
    (hsum : n0 + n1 + n2 + n3 = 8)
    (hmod : (n1 + n3).choose 2 % 7 = 0)
    (hodd : n0 * n1 + n0 * n2 + n2 * n3 +
      n1.choose 2 + n3.choose 2 = 14) : False := by
