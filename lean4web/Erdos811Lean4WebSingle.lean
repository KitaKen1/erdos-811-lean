/-! Concrete finite-q=9 bridge, stated for nine natural-number vertices.
If their 36 cyclic edge colours are injective, the residue-colour
histograms computed from endpoint class sizes are uniform. -/

namespace Erdos811Q9FiniteCountBridge

open Erdos811Q9DoubleCount Erdos811Q9UniformEdgeCounts

def residue6 (x : Fin 9 → Nat) (i : Fin 9) : Fin 6 :=
  ⟨x i % 6, Nat.mod_lt _ (by decide)⟩

def residue12 (x : Fin 9 → Nat) (i : Fin 9) : Fin 12 :=
  ⟨x i % 12, Nat.mod_lt _ (by decide)⟩

def residueColor3 (a b : Fin 6) : Fin 3 :=
  ⟨((a.val + b.val + 1) / 2) % 3, Nat.mod_lt _ (by decide)⟩

def residueColor6 (a b : Fin 12) : Fin 6 :=
  ⟨((a.val + b.val + 1) / 2) % 6, Nat.mod_lt _ (by decide)⟩

def finiteEdgeColorPair (x : Fin 9 → Nat) (p : Fin 9 × Fin 9) : Fin 36 :=
  ⟨Erdos811Q9ResidueArithmetic.edgeColor (x p.1) (x p.2),
    Nat.mod_lt _ (by decide)⟩

def finiteEdgeColor (x : Fin 9 → Nat) (p : {p // p ∈ edgePairs9}) : Fin 36 :=
  finiteEdgeColorPair x p.1

lemma finiteEdgeColor_mod3 (x : Fin 9 → Nat) (p : {p // p ∈ edgePairs9}) :
    (finiteEdgeColor x p).val % 3 =
      (residueColor3 (residue6 x p.1.1) (residue6 x p.1.2)).val := by
  exact Erdos811Q9ResidueArithmetic.edgeColor_mod3 _ _

lemma finiteEdgeColor_mod6 (x : Fin 9 → Nat) (p : {p // p ∈ edgePairs9}) :
    (finiteEdgeColor x p).val % 6 =
      (residueColor6 (residue12 x p.1.1) (residue12 x p.1.2)).val := by
  exact Erdos811Q9ResidueArithmetic.edgeColor_mod6 _ _

lemma residueColor3_symm (a b : Fin 6) : residueColor3 a b = residueColor3 b a := by
  apply Fin.ext
  simp only [residueColor3]
  congr 2
  omega

lemma residueColor6_symm (a b : Fin 12) : residueColor6 a b = residueColor6 b a := by
  apply Fin.ext
  simp only [residueColor6]
  congr 2
  omega

lemma increasingCount_eq_edgePairs9_filter {R : Type*} [DecidableEq R]
    (rho : Fin 9 → R) (P : R → R → Prop) [DecidableRel P] :
    increasingCount rho P =
      (edgePairs9.filter fun p => P (rho p.1) (rho p.2)).card := by
  simp only [increasingCount, edgePairs9, Finset.filter_filter]

theorem injective_edges_give_mod3_histogram
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (c : Fin 3) :
    increasingCount (residue6 x) (fun a b => residueColor3 a b = c) = 12 := by
  have hu := injective_mod3_count (finiteEdgeColor x) hinj edgePairs9_card c
  change (Finset.univ.filter fun p : {p // p ∈ edgePairs9} =>
    (finiteEdgeColorPair x p.1).val % 3 = c.val).card = 12 at hu
  rw [subtype_filter_card
    (fun p => (finiteEdgeColorPair x p).val % 3 = c.val)] at hu
  rw [increasingCount_eq_edgePairs9_filter]
  have heq :
      edgePairs9.filter (fun p =>
        residueColor3 (residue6 x p.1) (residue6 x p.2) = c) =
      edgePairs9.filter (fun p =>
        (finiteEdgeColorPair x p).val % 3 = c.val) := by
    ext p
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨hp, hcolor⟩
      refine ⟨hp, ?_⟩
      have hv := congrArg Fin.val hcolor
      exact (finiteEdgeColor_mod3 x ⟨p, hp⟩).trans hv
    · rintro ⟨hp, hcolor⟩
      refine ⟨hp, ?_⟩
      apply Fin.ext
      exact (finiteEdgeColor_mod3 x ⟨p, hp⟩).symm.trans hcolor
  rw [heq]
  exact hu

theorem injective_edges_give_mod6_histogram
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (c : Fin 6) :
    increasingCount (residue12 x) (fun a b => residueColor6 a b = c) = 6 := by
  have hu := injective_mod6_count (finiteEdgeColor x) hinj edgePairs9_card c
  change (Finset.univ.filter fun p : {p // p ∈ edgePairs9} =>
    (finiteEdgeColorPair x p.1).val % 6 = c.val).card = 6 at hu
  rw [subtype_filter_card
    (fun p => (finiteEdgeColorPair x p).val % 6 = c.val)] at hu
  rw [increasingCount_eq_edgePairs9_filter]
  have heq :
      edgePairs9.filter (fun p =>
        residueColor6 (residue12 x p.1) (residue12 x p.2) = c) =
      edgePairs9.filter (fun p =>
        (finiteEdgeColorPair x p).val % 6 = c.val) := by
    ext p
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨hp, hcolor⟩
      refine ⟨hp, ?_⟩
      have hv := congrArg Fin.val hcolor
      exact (finiteEdgeColor_mod6 x ⟨p, hp⟩).trans hv
    · rintro ⟨hp, hcolor⟩
      refine ⟨hp, ?_⟩
      apply Fin.ext
      exact (finiteEdgeColor_mod6 x ⟨p, hp⟩).symm.trans hcolor
  rw [heq]
  exact hu

theorem injective_edges_give_mod3_count_formula
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (c : Fin 3) :
    (∑ a : Fin 6, ∑ b : Fin 6,
      if residueColor3 a b = c then
        if a = b then
          (residueFiber (residue6 x) a).card *
            ((residueFiber (residue6 x) a).card - 1)
        else
          (residueFiber (residue6 x) a).card *
            (residueFiber (residue6 x) b).card
      else 0) = 24 := by
  rw [← directedCount_formula]
  rw [directedCount_eq_two_mul_increasingCount]
  · rw [injective_edges_give_mod3_histogram x hinj c]
  · intro a b
    rw [residueColor3_symm]

theorem injective_edges_give_mod6_count_formula
    (x : Fin 9 → Nat) (hinj : Function.Injective (finiteEdgeColor x))
    (c : Fin 6) :
    (∑ a : Fin 12, ∑ b : Fin 12,
      if residueColor6 a b = c then
        if a = b then
          (residueFiber (residue12 x) a).card *
            ((residueFiber (residue12 x) a).card - 1)
        else
          (residueFiber (residue12 x) a).card *
            (residueFiber (residue12 x) b).card
      else 0) = 12 := by
  rw [← directedCount_formula]
  rw [directedCount_eq_two_mul_increasingCount]
  · rw [injective_edges_give_mod6_histogram x hinj c]
  · intro a b
    rw [residueColor6_symm]

end Erdos811Q9FiniteCountBridge


