theorem q5AnyE_true_of_bound {a b c d e n : Nat}
    (hde : d < e) (he : e < n)
    (hr : (q5DirectEdges a b c d e).Nodup) :
    q5AnyE a b c d n = true := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hen : e = n
      · subst n
        simp [q5AnyE, hde, hr]
      · have hen' : e < n := by omega
        by_cases hdn : d < n
        · by_cases htest : decide (q5DirectEdges a b c d n).Nodup = true
          · simp [q5AnyE, hdn, htest]
          · simp [q5AnyE, hdn, htest, ih hen']
        · simp [q5AnyE, hdn, ih hen']

theorem q5AnyD_true_of_bound {a b c d n : Nat}
    (hcd : c < d) (hd : d < n)
    (hE : q5AnyE a b c d 21 = true) :
    q5AnyD a b c n = true := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hdn : d = n
      · subst n
        simp [q5AnyD, hcd, hE]
      · have hd' : d < n := by omega
        by_cases hcn : c < n
        · by_cases htest : q5AnyE a b c n 21 = true
          · simp [q5AnyD, hcn, htest]
          · simp [q5AnyD, hcn, htest, ih hd']
        · simp [q5AnyD, hcn, ih hd']

theorem q5AnyC_true_of_bound {a b c n : Nat}
    (hbc : b < c) (hc : c < n)
    (hD : q5AnyD a b c 21 = true) :
    q5AnyC a b n = true := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hcn : c = n
      · subst n
        simp [q5AnyC, hbc, hD]
      · have hc' : c < n := by omega
        by_cases hbn : b < n
        · by_cases htest : q5AnyD a b n 21 = true
          · simp [q5AnyC, hbn, htest]
          · simp [q5AnyC, hbn, htest, ih hc']
        · simp [q5AnyC, hbn, ih hc']

theorem q5TailPair_sound {a b c d e : Nat}
    (helt : e < 21)
    (hab : a < b) (hbc : b < c) (hcd : c < d) (hde : d < e)
    (hr : (q5DirectEdges a b c d e).Nodup) :
    q5TailPair a b = true := by
  have he : q5AnyE a b c d 21 = true :=
    q5AnyE_true_of_bound hde helt hr
  have hd : q5AnyD a b c 21 = true :=
    q5AnyD_true_of_bound (a := a) (b := b) (c := c) (d := d)
      hcd (by omega) he
  exact q5AnyC_true_of_bound (a := a) (b := b) (c := c)
    hbc (by omega) hd


