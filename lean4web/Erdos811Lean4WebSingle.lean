/-! BEGIN BUNDLED MODULE: Q9QuotientArithmetic -/


/-! Arithmetic identity behind the q=9 moment variables. -/

namespace Erdos811Q9QuotientArithmetic

open Erdos811Q9ResidueArithmetic

lemma edgeColor_quotient3
    {x y r s : Nat} (hr : r < 12) (hs : s < 12)
    (hx : x % 12 = r) (hy : y % 12 = s) :
    ((edgeColor x y / 6 : Nat) : ZMod 3) =
      ((x / 12 : Nat) : ZMod 3) + ((y / 12 : Nat) : ZMod 3) +
        ((((r + s + 1) / 2) / 6 : Nat) : ZMod 3) := by
  have hxrep : r + 12 * (x / 12) = x := by
    rw [← hx]
    exact Nat.mod_add_div x 12
  have hyrep : s + 12 * (y / 12) = y := by
    rw [← hy]
    exact Nat.mod_add_div y 12
  let base := (r + s + 1) / 2
  let lifts := x / 12 + y / 12
  have hbase : base < 12 := by
    dsimp [base]
    omega
  have hhalf : (x + y + 1) / 2 = base + 6 * lifts := by
    dsimp [base, lifts]
    omega
  have hquot : ((base + 6 * lifts) % 36) / 6 = (base / 6 + lifts) % 6 := by
    omega
  have hnat : (edgeColor x y / 6) % 3 =
      (x / 12 + y / 12 + base / 6) % 3 := by
    simp only [edgeColor, hhalf, hquot]
    rw [Nat.mod_mod_of_dvd _ (by decide : 3 ∣ 6)]
    dsimp [lifts]
    omega
  have hz := congrArg (fun n : Nat => (n : ZMod 3)) hnat
  simpa only [ZMod.natCast_mod, Nat.cast_add, base] using hz

