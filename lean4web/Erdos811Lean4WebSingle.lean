  unfold CompleteEdgeColoring.IsBalanced CompleteEdgeColoring.colorDegree
  decide +revert

def q5DirectEdges (a b c d e : Nat) : List Nat :=
  [q5PackedColor a b, q5PackedColor a c, q5PackedColor a d,
    q5PackedColor a e, q5PackedColor b c, q5PackedColor b d,
    q5PackedColor b e, q5PackedColor c d, q5PackedColor c e,
    q5PackedColor d e]

/- Tail-recursive bounded scans.  Each Nat argument is a decreasing budget,
so the kernel reduces a compact program instead of a nested List expression. -/
def q5AnyE (a b c d : Nat) : Nat → Bool
  | 0 => false
  | n + 1 =>
      let e := n
      if d < e then
        if decide (q5DirectEdges a b c d e).Nodup then true
        else q5AnyE a b c d n
      else q5AnyE a b c d n

def q5AnyD (a b c : Nat) : Nat → Bool
  | 0 => false
  | n + 1 =>
      let d := n
      if c < d then
        if q5AnyE a b c d 21 then true
        else q5AnyD a b c n
      else q5AnyD a b c n

def q5AnyC (a b : Nat) : Nat → Bool
  | 0 => false
  | n + 1 =>
      let c := n
      if b < c then
        if q5AnyD a b c 21 then true
        else q5AnyC a b n
      else q5AnyC a b n

def q5TailPair (a b : Nat) : Bool := q5AnyC a b 21

