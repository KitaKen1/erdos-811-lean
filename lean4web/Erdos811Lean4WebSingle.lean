/-! BEGIN BUNDLED MODULE: Q9OddCount12Bridge -/


/-! Convert the six odd residue counts modulo 12 to the parity sum. -/

namespace Erdos811Q9OddCount12Bridge

open Erdos811Q9DoubleCount Erdos811Q9FiniteCountBridge
open Erdos811Q9Good6Bridge

lemma odd_count12_eq_parity_sum (x : Fin 9 → Nat) :
    count12 x 1 + count12 x 3 + count12 x 5 + count12 x 7 +
        count12 x 9 + count12 x 11 =
      ∑ i : Fin 9, x i % 2 := by
  simp only [count12, residueFiber, Finset.card_filter]
  simp_rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [residue12, Fin.ext_iff, Fin.ofNat]
  have hr : x i % 12 < 12 := Nat.mod_lt _ (by decide)
  have hm : (x i % 12) % 2 = x i % 2 :=
    Nat.mod_mod_of_dvd _ (by decide : 2 ∣ 12)
  interval_cases hcase : x i % 12
  all_goals norm_num [hcase] at hm
  all_goals simp [hcase] <;> omega

end Erdos811Q9OddCount12Bridge


