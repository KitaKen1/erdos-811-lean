def translateVertices (x : Fin 9 → Nat) (s : Nat) : Fin 9 → Nat :=
  fun i => x i + s

lemma edgeColor_add (a b s : Nat) :
    Erdos811Q9ResidueArithmetic.edgeColor (a + s) (b + s) =
      (Erdos811Q9ResidueArithmetic.edgeColor a b + s) % 36 := by
  simp only [Erdos811Q9ResidueArithmetic.edgeColor]
  omega

lemma finiteEdgeColor_translate (x : Fin 9 → Nat) (s : Nat)
    (p : {p // p ∈ edgePairs9}) :
    (finiteEdgeColor (translateVertices x s) p).val =
      ((finiteEdgeColor x p).val + s) % 36 := by
  exact edgeColor_add _ _ _

theorem finiteEdgeColor_translate_injective (x : Fin 9 → Nat) (s : Nat)
    (hinj : Function.Injective (finiteEdgeColor x)) :
    Function.Injective (finiteEdgeColor (translateVertices x s)) := by
  intro p q hpq
  apply hinj
  apply Fin.ext
  have hval := congrArg Fin.val hpq
  simp only [finiteEdgeColor_translate] at hval
  omega

def shiftBack12 (s : Nat) (r : Fin 12) : Fin 12 :=
  ⟨(r.val + 12 - s) % 12, Nat.mod_lt _ (by decide)⟩

lemma mod12_add_cancel (a s : Nat) (r : Fin 12) (hs : s < 12) :
    (a + s) % 12 = r.val ↔ a % 12 = (shiftBack12 s r).val := by
  simp only [shiftBack12]
  omega

lemma count12_translate (x : Fin 9 → Nat) (s : Nat) (hs : s < 12)
    (r : Fin 12) :
    count12 (translateVertices x s) r = count12 x (shiftBack12 s r) := by
  apply congrArg Finset.card
  ext i
  simp only [count12, residueFiber, Finset.mem_filter, Finset.mem_univ, true_and,
    residue12, translateVertices, Fin.ext_iff]
  exact mod12_add_cancel (x i) s r hs

lemma counts12_translate_components (x : Fin 9 → Nat) (s : Nat) (hs : s < 12) :
    counts12 (translateVertices x s) =
      [count12 x (shiftBack12 s 0), count12 x (shiftBack12 s 1),
        count12 x (shiftBack12 s 2), count12 x (shiftBack12 s 3),
        count12 x (shiftBack12 s 4), count12 x (shiftBack12 s 5),
        count12 x (shiftBack12 s 6), count12 x (shiftBack12 s 7),
        count12 x (shiftBack12 s 8), count12 x (shiftBack12 s 9),
        count12 x (shiftBack12 s 10), count12 x (shiftBack12 s 11)] := by
  simp only [counts12]
  rw [count12_translate x s hs 0, count12_translate x s hs 1,
    count12_translate x s hs 2, count12_translate x s hs 3,
    count12_translate x s hs 4, count12_translate x s hs 5,
    count12_translate x s hs 6, count12_translate x s hs 7,
    count12_translate x s hs 8, count12_translate x s hs 9,
    count12_translate x s hs 10, count12_translate x s hs 11]

def count12Nat (x : Fin 9 → Nat) (r : Nat) : Nat :=
  ((Finset.univ : Finset (Fin 9)).filter fun i => x i % 12 = r).card

lemma count12_eq_count12Nat (x : Fin 9 → Nat) (r : Fin 12) :
    count12 x r = count12Nat x r.val := by
  apply congrArg Finset.card
  ext i
  simp only [count12, count12Nat, residueFiber, Finset.mem_filter,
    Finset.mem_univ, true_and, residue12, Fin.ext_iff]

private def representative1 : List Nat :=
  [0, 0, 2, 0, 2, 1, 1, 1, 0, 1, 0, 1]

