/-!
# q=9 compact proof components (not yet the all-cliques theorem)

One file, with standard Mathlib imports only. No local imports, external
files, SAT solver, native_decide, or additional axioms are used.

Proved here: exhaustive count-vector classifications (6, then 48, then
4 translation orbits), and algebraic impossibility of the four moment
systems over ZMod 3.

Still required to replace the project's q=9 LRAT theorem: the formal
graph-to-count, reindexing/translation, and graph-to-moment bridges.
This file intentionally does not claim that connection or K_q for all q.

Locally tested with Lean 4.27.0. Browser-server resource limits may differ.
-/

set_option linter.unusedVariables false


/-! Kernel-checked residue count classifications for q=9.
The first predicate is the explicit color histogram modulo 3, and the
second is the histogram modulo 6. These lemmas classify count vectors.
The graph-to-histogram correspondence is a separate proof obligation. -/

namespace Erdos811Q9ResidueCounts

def compositionsCheck : Nat → Nat → (List Nat → Bool) → Bool
  | 0, budget, p => if budget = 0 then p [] else true
  | n+1, budget, p => (List.range (budget+1)).all fun v =>
      compositionsCheck n (budget-v) (fun xs => p (v :: xs))

theorem compositionsCheck_sound (xs : List Nat) (p : List Nat → Bool)
    (h : compositionsCheck xs.length xs.sum p = true) : p xs = true := by
  induction xs generalizing p with
  | nil => simpa [compositionsCheck] using h
  | cons v xs ih =>
    have hv : v ∈ List.range ((v :: xs).sum + 1) := by
      simp only [List.mem_range, List.sum_cons]
      omega
    have ht := (List.all_eq_true.mp h) v hv
    apply ih (fun ys => p (v :: ys))
    simpa only [List.sum_cons, Nat.add_sub_cancel_left] using ht

def refinementsCheck : List Nat → (List (Nat × Nat) → Bool) → Bool
  | [], p => p []
  | n :: ns, p => (List.range (n+1)).all fun a =>
      refinementsCheck ns (fun ps => p ((a,n-a) :: ps))

theorem refinementsCheck_sound (ps : List (Nat × Nat))
    (p : List (Nat × Nat) → Bool)
    (h : refinementsCheck (ps.map fun ab => ab.1+ab.2) p = true) : p ps = true := by
  induction ps generalizing p with
  | nil => exact h
  | cons ab ps ih =>
    have hab : ab.1 ∈ List.range (ab.1 + ab.2 + 1) := by
      simp only [List.mem_range]
      omega
    have ht := (List.all_eq_true.mp h) ab.1 hab
    apply ih (fun qs => p (ab :: qs))
    simpa only [Nat.add_sub_cancel_left] using ht

