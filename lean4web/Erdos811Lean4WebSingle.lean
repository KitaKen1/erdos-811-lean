/-!
Reusable kernel proof for the graph-to-count bridge.

`directedFiber rho a b` is the set of ordered, distinct vertex pairs
whose endpoint residues are `a,b`.  Its cardinality is determined only
by the two residue-class sizes.  The directed formulation avoids a
choice of orientation; the later q=9 bridge divides by the endpoint swap.
-/

open scoped BigOperators

namespace Erdos811Q9DoubleCount

variable {V R : Type*} [Fintype V] [DecidableEq V]
  [Fintype R] [DecidableEq R]

def residueFiber (rho : V → R) (a : R) : Finset V :=
  Finset.univ.filter fun v => rho v = a

def directedFiber (rho : V → R) (a b : R) : Finset (V × V) :=
  Finset.univ.offDiag.filter fun p => rho p.1 = a ∧ rho p.2 = b

lemma directedFiber_eq_product_of_ne (rho : V → R) {a b : R} (hab : a ≠ b) :
    directedFiber rho a b = residueFiber rho a ×ˢ residueFiber rho b := by
  ext p
  simp only [directedFiber, residueFiber, Finset.mem_filter,
    Finset.mem_offDiag, Finset.mem_univ, true_and, Finset.mem_product]
  constructor
  · rintro ⟨_, ha, hb⟩
    exact ⟨ha, hb⟩
  · rintro ⟨ha, hb⟩
    refine ⟨?_, ha, hb⟩
    intro hp
    apply hab
    exact ha.symm.trans ((congrArg rho hp).trans hb)

lemma directedFiber_eq_offDiag (rho : V → R) (a : R) :
    directedFiber rho a a = (residueFiber rho a).offDiag := by
  ext p
  simp only [directedFiber, residueFiber, Finset.mem_filter,
    Finset.mem_offDiag, Finset.mem_univ, true_and]
  aesop

lemma directedFiber_card (rho : V → R) (a b : R) :
    (directedFiber rho a b).card =
      if a = b then
        (residueFiber rho a).card * ((residueFiber rho a).card - 1)
      else
        (residueFiber rho a).card * (residueFiber rho b).card := by
  by_cases hab : a = b
  · subst b
    simp [directedFiber_eq_offDiag, Finset.offDiag_card,
      Nat.mul_sub_left_distrib]
  · rw [if_neg hab, directedFiber_eq_product_of_ne rho hab]
    exact Finset.card_product _ _

def directedCount (rho : V → R) (P : R → R → Prop)
    [DecidableRel P] : Nat :=
  (Finset.univ.offDiag.filter fun p => P (rho p.1) (rho p.2)).card

lemma directedCount_eq_sum (rho : V → R) (P : R → R → Prop)
    [DecidableRel P] :
    directedCount rho P =
      ∑ a : R, ∑ b : R,
        if P a b then (directedFiber rho a b).card else 0 := by
  let s : Finset (V × V) :=
    Finset.univ.offDiag.filter fun p => P (rho p.1) (rho p.2)
  have hfirst :
      s.card = ∑ a : R, (s.filter fun p => rho p.1 = a).card := by
    simpa using (Finset.card_eq_sum_card_fiberwise
      (s := s) (t := (Finset.univ : Finset R)) (f := fun p => rho p.1)
      (by intro p hp; simp))
  rw [directedCount, show
      (Finset.univ.offDiag.filter fun p => P (rho p.1) (rho p.2)) = s from rfl,
    hfirst]
  apply Finset.sum_congr rfl
  intro a ha
  have hsecond :
      (s.filter fun p => rho p.1 = a).card =
        ∑ b : R, ((s.filter fun p => rho p.1 = a).filter fun p => rho p.2 = b).card := by
    simpa using (Finset.card_eq_sum_card_fiberwise
      (s := s.filter fun p => rho p.1 = a)
      (t := (Finset.univ : Finset R)) (f := fun p => rho p.2)
      (by intro p hp; simp))
  rw [hsecond]
  apply Finset.sum_congr rfl
  intro b hb
  by_cases hP : P a b
  · simp only [if_pos hP]
    congr 1
    ext p
    simp only [s, directedFiber, Finset.mem_filter, Finset.mem_offDiag,
      Finset.mem_univ, true_and]
    aesop
  · simp only [if_neg hP, Finset.card_eq_zero]
    ext p
    simp [s]
    aesop

theorem directedCount_formula (rho : V → R) (P : R → R → Prop)
    [DecidableRel P] :
    directedCount rho P =
      ∑ a : R, ∑ b : R,
        if P a b then
          if a = b then
            (residueFiber rho a).card * ((residueFiber rho a).card - 1)
          else
            (residueFiber rho a).card * (residueFiber rho b).card
        else 0 := by
  rw [directedCount_eq_sum]
  apply Finset.sum_congr rfl
  intro a ha
  apply Finset.sum_congr rfl
  intro b hb
  by_cases hP : P a b
  · simp [hP, directedFiber_card]
  · simp [hP]

section LinearOrder

variable [LinearOrder V]

def increasingCount (rho : V → R) (P : R → R → Prop)
    [DecidableRel P] : Nat :=
  ((Finset.univ.product Finset.univ).filter
    fun p : V × V => p.1 < p.2 ∧ P (rho p.1) (rho p.2)).card

theorem directedCount_eq_two_mul_increasingCount
    (rho : V → R) (P : R → R → Prop) [DecidableRel P]
    (hsym : ∀ a b, P a b ↔ P b a) :
    directedCount rho P = 2 * increasingCount rho P := by
  let inc : Finset (V × V) :=
    (Finset.univ.product Finset.univ).filter
      fun p => p.1 < p.2 ∧ P (rho p.1) (rho p.2)
  let dec : Finset (V × V) :=
    (Finset.univ.product Finset.univ).filter
      fun p => p.2 < p.1 ∧ P (rho p.1) (rho p.2)
  have hsplit :
      Finset.univ.offDiag.filter (fun p => P (rho p.1) (rho p.2)) =
        inc ∪ dec := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_union]
    constructor
    · rintro ⟨hoff, hP⟩
      have hne : p.1 ≠ p.2 := (Finset.mem_offDiag.mp hoff).2.2
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · apply Or.inl
        exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr
          ⟨Finset.mem_univ _, Finset.mem_univ _⟩, hlt, hP⟩
      · apply Or.inr
        exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr
          ⟨Finset.mem_univ _, Finset.mem_univ _⟩, hgt, hP⟩
    · intro hor
      rcases hor with hp | hp
      · rcases Finset.mem_filter.mp hp with ⟨_, hlt, hP⟩
        exact ⟨Finset.mem_offDiag.mpr
          ⟨Finset.mem_univ _, Finset.mem_univ _, ne_of_lt hlt⟩, hP⟩
      · rcases Finset.mem_filter.mp hp with ⟨_, hgt, hP⟩
        exact ⟨Finset.mem_offDiag.mpr
          ⟨Finset.mem_univ _, Finset.mem_univ _, ne_of_gt hgt⟩, hP⟩
  have hdisj : Disjoint inc dec := by
    rw [Finset.disjoint_left]
    intro p hpinc hpdec
    have hlt : p.1 < p.2 := (Finset.mem_filter.mp hpinc).2.1
    have hgt : p.2 < p.1 := (Finset.mem_filter.mp hpdec).2.1
    exact lt_asymm hlt hgt
  have hswap : dec.card = inc.card := by
    apply Finset.card_bij (fun (p : V × V) _ => p.swap)
    · intro p hp
      rcases Finset.mem_filter.mp hp with ⟨_, hlt, hP⟩
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩,
        hlt, (hsym _ _).mp hP⟩
    · intro p hp q hq hpq
      exact Prod.swap_injective hpq
    · intro p hp
      refine ⟨p.swap, ?_, p.swap_swap⟩
      rcases Finset.mem_filter.mp hp with ⟨_, hlt, hP⟩
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩,
        hlt, (hsym _ _).mpr hP⟩
  rw [directedCount, hsplit, Finset.card_union_of_disjoint hdisj, hswap]
  change inc.card + inc.card = 2 * inc.card
  omega

end LinearOrder

end Erdos811Q9DoubleCount


