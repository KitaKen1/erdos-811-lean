/-! BEGIN BUNDLED MODULE: Q9ResidueReindex -/


/-! Reindex a finite family when all residue-fibre cardinalities agree. -/

namespace Erdos811Q9ResidueReindex

open Erdos811Q9DoubleCount

def fiberSubtypeEquiv
    {V R : Type*} [Fintype V] [DecidableEq V] [DecidableEq R]
    (rho : V → R) (r : R) :
    {v : V // rho v = r} ≃ residueFiber rho r where
  toFun v := ⟨v, Finset.mem_filter.mpr ⟨Finset.mem_univ _, v.2⟩⟩
  invFun v := ⟨v, (Finset.mem_filter.mp v.2).2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem exists_residue_preserving_equiv
    {V R : Type*} [Fintype V] [DecidableEq V]
    [Fintype R] [DecidableEq R]
    (rho sigma : V → R)
    (hcard : ∀ r, (residueFiber rho r).card = (residueFiber sigma r).card) :
    ∃ e : V ≃ V, ∀ v, rho (e v) = sigma v := by
  classical
  let er (r : R) : {v : V // sigma v = r} ≃ {v : V // rho v = r} :=
    (fiberSubtypeEquiv sigma r).trans <|
      (Finset.equivOfCardEq (hcard r).symm).trans
        (fiberSubtypeEquiv rho r).symm
  let e : V ≃ V := Equiv.ofFiberEquiv er
  exact ⟨e, fun v => Equiv.ofFiberEquiv_map er v⟩

end Erdos811Q9ResidueReindex


