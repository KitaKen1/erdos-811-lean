namespace Erdos811Q9Good6Bridge

open Erdos811Q9DoubleCount Erdos811Q9FiniteCountBridge

def count12 (x : Fin 9 → Nat) (r : Fin 12) : Nat :=
  (residueFiber (residue12 x) r).card

def counts12 (x : Fin 9 → Nat) : List Nat :=
  [count12 x 0, count12 x 1, count12 x 2, count12 x 3,
    count12 x 4, count12 x 5, count12 x 6, count12 x 7,
    count12 x 8, count12 x 9, count12 x 10, count12 x 11]

