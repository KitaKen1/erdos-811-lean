/-! BEGIN BUNDLED MODULE: Q9ArrangedMoments -/


/-! First/square moment equations for a residue-arranged list of nine
finite vertices. -/

open scoped BigOperators

namespace Erdos811Q9ArrangedMoments

open Erdos811Q9UniformEdgeCounts Erdos811Q9FiniteCountBridge
open Erdos811Q9EdgeMoments Erdos811Q9QuotientArithmetic

def liftVar (y : Fin 9 → Nat) (i : Fin 9) : ZMod 3 :=
  ((y i / 12 : Nat) : ZMod 3)

def carry3 (r s : Fin 12) : ZMod 3 :=
  (((((r.val + s.val + 1) / 2) / 6 : Nat)) : ZMod 3)

lemma quotient3_finiteEdgeColorPair
    (residues : Fin 9 → Fin 12) (y : Fin 9 → Nat)
    (hres : ∀ i, residue12 y i = residues i) (p : Fin 9 × Fin 9) :
    quotient3 (finiteEdgeColorPair y p) =
      liftVar y p.1 + liftVar y p.2 + carry3 (residues p.1) (residues p.2) := by
  have hx := congrArg Fin.val (hres p.1)
  have hy := congrArg Fin.val (hres p.2)
  simpa only [quotient3, finiteEdgeColorPair,
    liftVar, carry3] using
      (edgeColor_quotient3 (residues p.1).isLt (residues p.2).isLt hx hy)

lemma arranged_filter_eq
    (residues : Fin 9 → Fin 12) (y : Fin 9 → Nat)
    (hres : ∀ i, residue12 y i = residues i) (c : Fin 6) :
    edgePairs9.filter (fun p => (finiteEdgeColorPair y p).val % 6 = c.val) =
      edgePairs9.filter (fun p => residueColor6 (residues p.1) (residues p.2) = c) := by
  ext p
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hp, hc⟩
    refine ⟨hp, ?_⟩
    apply Fin.ext
    have hcolor := finiteEdgeColor_mod6 y ⟨p, hp⟩
    rw [hres p.1, hres p.2] at hcolor
    exact hcolor.symm.trans hc
  · rintro ⟨hp, hc⟩
    refine ⟨hp, ?_⟩
    have hcv := congrArg Fin.val hc
    have hcolor := finiteEdgeColor_mod6 y ⟨p, hp⟩
    rw [hres p.1, hres p.2] at hcolor
    exact hcolor.trans hcv

theorem arranged_quotient_sum
    (residues : Fin 9 → Fin 12) (y : Fin 9 → Nat)
    (hres : ∀ i, residue12 y i = residues i)
    (hinj : Function.Injective (finiteEdgeColor y)) (c : Fin 6) :
    (edgePairs9.filter
      (fun p => residueColor6 (residues p.1) (residues p.2) = c)).sum
      (fun p => liftVar y p.1 + liftVar y p.2 +
        carry3 (residues p.1) (residues p.2)) = 0 := by
  have h := injective_quotient_sum (finiteEdgeColor y) hinj edgePairs9_card c
  change (∑ p ∈ Finset.univ.filter
      (fun p : {p // p ∈ edgePairs9} =>
        (finiteEdgeColorPair y p.1).val % 6 = c.val),
      quotient3 (finiteEdgeColorPair y p.1)) = 0 at h
  rw [subtype_filter_sum edgePairs9
    (fun p => (finiteEdgeColorPair y p).val % 6 = c.val)
    (fun p => quotient3 (finiteEdgeColorPair y p))] at h
  rw [arranged_filter_eq residues y hres c] at h
  calc
    _ = (edgePairs9.filter
        (fun p => residueColor6 (residues p.1) (residues p.2) = c)).sum
        (fun p => quotient3 (finiteEdgeColorPair y p)) := by
      apply Finset.sum_congr rfl
      intro p hp
      exact (quotient3_finiteEdgeColorPair residues y hres p).symm
    _ = 0 := h

theorem arranged_quotient_square_sum
    (residues : Fin 9 → Fin 12) (y : Fin 9 → Nat)
    (hres : ∀ i, residue12 y i = residues i)
    (hinj : Function.Injective (finiteEdgeColor y)) (c : Fin 6) :
    (edgePairs9.filter
      (fun p => residueColor6 (residues p.1) (residues p.2) = c)).sum
      (fun p => (liftVar y p.1 + liftVar y p.2 +
        carry3 (residues p.1) (residues p.2)) ^ 2) = 1 := by
  have h := injective_quotient_square_sum
    (finiteEdgeColor y) hinj edgePairs9_card c
  change (∑ p ∈ Finset.univ.filter
      (fun p : {p // p ∈ edgePairs9} =>
        (finiteEdgeColorPair y p.1).val % 6 = c.val),
      (quotient3 (finiteEdgeColorPair y p.1)) ^ 2) = 1 at h
  rw [subtype_filter_sum edgePairs9
    (fun p => (finiteEdgeColorPair y p).val % 6 = c.val)
    (fun p => (quotient3 (finiteEdgeColorPair y p)) ^ 2)] at h
  rw [arranged_filter_eq residues y hres c] at h
  calc
    _ = (edgePairs9.filter
        (fun p => residueColor6 (residues p.1) (residues p.2) = c)).sum
        (fun p => (quotient3 (finiteEdgeColorPair y p)) ^ 2) := by
      apply Finset.sum_congr rfl
      intro p hp
      exact congrArg (fun z : ZMod 3 => z ^ 2)
        (quotient3_finiteEdgeColorPair residues y hres p).symm
    _ = 1 := h

end Erdos811Q9ArrangedMoments


