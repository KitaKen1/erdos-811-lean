/-! BEGIN BUNDLED MODULE: Q9ColorResiduesNat -/


/-! Standalone arithmetic part of the q=9 residue bridge. -/

namespace Erdos811Q9ResidueArithmetic

def edgeColor (x y : Nat) : Nat := ((x + y + 1) / 2) % 36

lemma edgeColor_mod3 (x y : Nat) :
    edgeColor x y % 3 =
      (((x % 6) + (y % 6) + 1) / 2) % 3 := by
  simp only [edgeColor]
  rw [Nat.mod_mod_of_dvd _ (by decide : 3 ∣ 36)]
  have hxrep : x % 6 + 6 * (x / 6) = x := Nat.mod_add_div x 6
  have hyrep : y % 6 + 6 * (y / 6) = y := Nat.mod_add_div y 6
  have hsum : x + y + 1 =
      (x % 6 + y % 6 + 1) + 2 * (3 * (x / 6 + y / 6)) := by
    omega
  rw [hsum, Nat.add_mul_div_left _ _ (by decide : 0 < 2)]
  exact Nat.add_mul_mod_self_left _ _ _

lemma edgeColor_mod6 (x y : Nat) :
    edgeColor x y % 6 =
      (((x % 12) + (y % 12) + 1) / 2) % 6 := by
  simp only [edgeColor]
  rw [Nat.mod_mod_of_dvd _ (by decide : 6 ∣ 36)]
  have hxrep : x % 12 + 12 * (x / 12) = x := Nat.mod_add_div x 12
  have hyrep : y % 12 + 12 * (y / 12) = y := Nat.mod_add_div y 12
  have hsum : x + y + 1 =
      (x % 12 + y % 12 + 1) + 2 * (6 * (x / 12 + y / 12)) := by
    omega
  rw [hsum, Nat.add_mul_div_left _ _ (by decide : 0 < 2)]
  exact Nat.add_mul_mod_self_left _ _ _

end Erdos811Q9ResidueArithmetic


